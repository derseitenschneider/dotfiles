#!/usr/bin/env python3
"""bxapi: the Bexio REST API for accounting reads and manual entries.

Token: $BEXIO_TOKEN, else `op read "op://Employee/Bexio API/credential"` (1Password CLI).
Stdlib only. Run `bxapi help`.
"""
import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import date, datetime

API = "https://api.bexio.com"
OP_REF = "op://Employee/Bexio API/credential"
CHF = 1  # currency id of the base currency

USAGE = """Reading
  bxapi check                                  token works? prints company and rate-limit headers
  bxapi accounts [--json] [--all]              chart of accounts: no, id, uuid, name (active only unless --all)
  bxapi journal --account NO --from D --to D [--json] [--resolve]
                                               every journal row touching the account in the range (D = YYYY-MM-DD);
                                               --resolve names the supplier and bill behind each Zahlungsausgang
  bxapi balance --account NO --at D            saldo at end of day D, summed from the journal since 1 January
  bxapi entry get ID                           one manual entry
Writing (manual entries, no tax, CHF)
  bxapi entry create --date D --debit NO --credit NO --amount X --text T [--dry-run]
  bxapi entry delete ID --yes                  permanent, no undo
  bxapi book FILE.json [--dry-run] [--out R.json]
                                               batch of entries; skips rows already in the journal, stops on
                                               the first error. FILE: [{"key","date","debit","credit","amount",
                                               "text"}, ...]. R.json: the same rows plus status and entry id.
Plumbing
  bxapi get PATH [k=v ...]                     raw GET, prints JSON (e.g. bxapi get /2.0/kb_invoice/123)
"""


# ---------- http ----------

def die(msg, code=1):
    print(f"bxapi: {msg}", file=sys.stderr)
    sys.exit(code)


def token():
    t = os.environ.get("BEXIO_TOKEN")
    if t:
        return t.strip()
    try:
        out = subprocess.run(["op", "read", OP_REF], capture_output=True, text=True, check=True)
    except FileNotFoundError:
        die("1Password CLI `op` not found and $BEXIO_TOKEN not set")
    except subprocess.CalledProcessError as e:
        die(f"op read failed: {e.stderr.strip()}")
    return out.stdout.strip()


_headers_seen = {}


def call(method, path, params=None, body=None):
    url = API + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Accept", "application/json")
    req.add_header("Authorization", "Bearer " + token())
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            for k in ("RateLimit-Limit", "RateLimit-Remaining", "RateLimit-Reset"):
                if r.headers.get(k):
                    _headers_seen[k] = r.headers[k]
            raw = r.read()
            return json.loads(raw) if raw else None
    except urllib.error.HTTPError as e:
        text = e.read().decode(errors="replace")
        if e.code == 401:
            die("401 Unauthorized. The Personal Access Token is missing or expired (they last 60 days).\n"
                "  Create a new one at https://developer.bexio.com/pat and store it in 1Password:\n"
                f"  {OP_REF}", 3)
        if e.code == 429:
            die(f"429 rate limited, retry after {e.headers.get('RateLimit-Reset', '?')} s", 4)
        die(f"HTTP {e.code} on {method} {path}: {text[:600]}", 2)


# ---------- helpers ----------

def arg(args, name, default=None, required=False):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            die(f"{name} needs a value")
        return args[i + 1]
    if required:
        die(f"missing {name}")
    return default


def flag(args, name):
    return name in args


def iso(d):
    try:
        return date.fromisoformat(d).isoformat()
    except ValueError:
        die(f"bad date {d!r}, want YYYY-MM-DD")


def fmt(x):
    s = f"{abs(x):,.2f}".replace(",", "'")
    return ("-" if x < 0 else "") + s


def load_accounts(include_inactive=False):
    rows = call("GET", "/2.0/accounts", {"limit": 2000})
    out = [r for r in rows if include_inactive or r.get("is_active")]
    return sorted(out, key=lambda r: r["account_no"])


def resolve_account(no, accounts=None):
    accounts = accounts or load_accounts(include_inactive=True)
    hits = [a for a in accounts if a["account_no"] == str(no)]
    if not hits:
        die(f"account {no} not found in the Kontenplan")
    if len(hits) > 1:
        active = [a for a in hits if a.get("is_active")]
        hits = active or hits[:1]
    return hits[0]


def journal_rows(account_uuid, frm, to):
    out, offset = [], 0
    while True:
        page = call("GET", "/3.0/accounting/journal",
                    {"from": frm, "to": to, "account_uuid": account_uuid, "limit": 2000, "offset": offset})
        out.extend(page)
        if len(page) < 2000:
            return out
        offset += 2000


def journal_all(frm, to):
    out, offset = [], 0
    while True:
        page = call("GET", "/3.0/accounting/journal", {"from": frm, "to": to, "limit": 2000, "offset": offset})
        out.extend(page)
        if len(page) < 2000:
            return out
        offset += 2000


def day(row):
    return row["date"][:10]


# ---------- commands ----------

def cmd_check(args):
    prof = call("GET", "/2.0/company_profile")
    name = prof[0]["name"] if isinstance(prof, list) and prof else prof.get("name") if isinstance(prof, dict) else "?"
    print(f"ok  company: {name}")
    if _headers_seen:
        print("    " + "  ".join(f"{k}={v}" for k, v in _headers_seen.items()))


def cmd_accounts(args):
    rows = load_accounts(include_inactive=flag(args, "--all"))
    if flag(args, "--json"):
        print(json.dumps([{"no": r["account_no"], "id": r["id"], "uuid": r["uuid"], "name": r["name"],
                           "active": bool(r.get("is_active"))} for r in rows], ensure_ascii=False, indent=1))
        return
    for r in rows:
        print(f"{r['account_no']:>5}  id={r['id']:<4} {r['uuid']}  {r['name']}{'' if r.get('is_active') else '  (inactive)'}")


def resolve_outgoing(ref_uuid, cache):
    """Zahlungsausgang rows carry the uuid of a purchase outgoing payment; follow it to the bill."""
    if ref_uuid in cache:
        return cache[ref_uuid]
    text = None
    try:
        pay = call("GET", f"/4.0/purchase/outgoing-payments/{ref_uuid}")
        bill = call("GET", f"/4.0/purchase/bills/{pay['bill_id']}")
        who = bill.get("lastname_company") or bill.get("firstname_suffix") or "?"
        text = f"{who} · bill {bill.get('document_no')} · {bill.get('title') or ''}".strip(" ·")
    except SystemExit:
        text = None
    cache[ref_uuid] = text
    return text


def cmd_journal(args):
    no = arg(args, "--account", required=True)
    frm, to = iso(arg(args, "--from", required=True)), iso(arg(args, "--to", required=True))
    accounts = load_accounts(include_inactive=True)
    acc = resolve_account(no, accounts)
    by_id = {a["id"]: a for a in accounts}
    rows = sorted(journal_rows(acc["uuid"], frm, to), key=lambda r: (day(r), r["id"]))
    resolve, cache = flag(args, "--resolve"), {}
    out = []
    for r in rows:
        debit, credit = by_id.get(r["debit_account_id"]), by_id.get(r["credit_account_id"])
        amt = float(r["base_currency_amount"])
        side = "debit" if r["debit_account_id"] == acc["id"] else "credit"
        out.append({
            "id": r["id"], "date": day(r),
            "debit": debit["account_no"] if debit else str(r["debit_account_id"]),
            "credit": credit["account_no"] if credit else str(r["credit_account_id"]),
            "amount": round(amt, 2),
            "signed": round(amt if side == "debit" else -amt, 2),
            "description": r.get("description") or "",
            "ref_class": r.get("ref_class"), "ref_id": r.get("ref_id"), "ref_uuid": r.get("ref_uuid"),
            "currency_id": r.get("currency_id"), "currency_amount": r.get("amount"),
            "currency_factor": r.get("currency_factor"),
            "resolved": resolve_outgoing(r["ref_uuid"], cache)
            if resolve and r.get("ref_class") == "KbClientAccountEntry" and r.get("ref_uuid") else None,
        })
    if flag(args, "--json"):
        print(json.dumps(out, ensure_ascii=False, indent=1))
        return
    net = 0.0
    for r in out:
        net += r["signed"]
        kind = {"KbClientAccountEntry": "payment", None: "manual"}.get(r["ref_class"], r["ref_class"] or "")
        text = r["description"] + (f"  → {r['resolved']}" if r.get("resolved") else "")
        print(f"{r['date']}  {r['id']:>6}  {r['debit']:>5} / {r['credit']:<5}  {fmt(r['signed']):>12}  {kind:<8} {text}")
    print(f"{len(out)} rows, net on {acc['account_no']}: {fmt(net)}")


def balance_at(acc, at):
    year_start = f"{at[:4]}-01-01"
    rows = journal_rows(acc["uuid"], year_start, at)
    bal = 0.0
    for r in rows:
        amt = float(r["base_currency_amount"])
        bal += amt if r["debit_account_id"] == acc["id"] else -amt
    return round(bal, 2), len(rows)


def cmd_balance(args):
    no, at = arg(args, "--account", required=True), iso(arg(args, "--at", required=True))
    acc = resolve_account(no)
    bal, n = balance_at(acc, at)
    print(f"{acc['account_no']} {acc['name']}  saldo {at}: {fmt(bal)}  ({n} journal rows since {at[:4]}-01-01)")


def entry_body(date_, debit, credit, amount, text, accounts):
    d, c = resolve_account(debit, accounts), resolve_account(credit, accounts)
    if len(text) > 255:
        die("text longer than 255 characters")
    return {
        "type": "manual_single_entry",
        "date": iso(date_),
        "entries": [{
            "debit_account_id": d["id"], "credit_account_id": c["id"],
            "amount": round(float(amount), 2), "description": text,
            "currency_id": CHF, "currency_factor": 1,
        }],
    }


def describe_body(b):
    e = b["entries"][0]
    return f"{b['date']}  {e['debit_account_id']} / {e['credit_account_id']}  {fmt(e['amount'])}  {e['description']}"


def find_existing(journal, date_, debit_id, credit_id, amount):
    for r in journal:
        if day(r) == date_ and r["debit_account_id"] == debit_id and r["credit_account_id"] == credit_id \
                and abs(float(r["base_currency_amount"]) - amount) < 0.005:
            return r
    return None


def cmd_entry(args):
    if not args:
        die("entry get|create|delete")
    sub, rest = args[0], args[1:]
    if sub == "get":
        print(json.dumps(call("GET", f"/3.0/accounting/manual_entries/{int(rest[0])}"), ensure_ascii=False, indent=1))
    elif sub == "create":
        accounts = load_accounts(include_inactive=True)
        body = entry_body(arg(rest, "--date", required=True), arg(rest, "--debit", required=True),
                          arg(rest, "--credit", required=True), arg(rest, "--amount", required=True),
                          arg(rest, "--text", required=True), accounts)
        if flag(rest, "--dry-run"):
            print("DRY RUN, would POST /3.0/accounting/manual_entries")
            print(json.dumps(body, ensure_ascii=False, indent=1))
            return
        res = call("POST", "/3.0/accounting/manual_entries", body=body)
        print(f"created manual entry id={res.get('id')} ref={res.get('reference_nr')}  {describe_body(body)}")
    elif sub == "delete":
        if not flag(rest, "--yes"):
            die("delete is permanent; add --yes")
        eid = int(rest[0])
        before = call("GET", f"/3.0/accounting/manual_entries/{eid}")
        call("DELETE", f"/3.0/accounting/manual_entries/{eid}")
        print(f"deleted manual entry {eid} (was ref={before.get('reference_nr')} date={before.get('date')})")
    else:
        die("entry get|create|delete")


def cmd_book(args):
    if not args:
        die("book FILE.json [--dry-run] [--out R.json]")
    path, dry, out_path = args[0], flag(args, "--dry-run"), arg(args, "--out")
    with open(path) as f:
        rows = json.load(f)
    if not isinstance(rows, list) or not rows:
        die("FILE must hold a non-empty JSON array")
    for i, r in enumerate(rows):
        for k in ("date", "debit", "credit", "amount", "text"):
            if k not in r:
                die(f"row {i} ({r.get('key', '?')}): missing {k}")
        r.setdefault("key", f"row{i}")
    accounts = load_accounts(include_inactive=True)
    bodies = [entry_body(r["date"], r["debit"], r["credit"], r["amount"], r["text"], accounts) for r in rows]
    dates = [b["date"] for b in bodies]
    journal = journal_all(min(dates), max(dates))
    results, stop = [], False
    for r, b in zip(rows, bodies):
        e = b["entries"][0]
        res = dict(r)
        res["debit_id"], res["credit_id"] = e["debit_account_id"], e["credit_account_id"]
        existing = find_existing(journal, b["date"], e["debit_account_id"], e["credit_account_id"], e["amount"])
        if existing:
            res.update(status="exists", journal_id=existing["id"], existing_description=existing.get("description"))
            print(f"exists   {r['key']:<12} {describe_body(b)}   (journal id {existing['id']}: {existing.get('description')!r})")
        elif stop:
            res.update(status="not_sent")
            print(f"skipped  {r['key']:<12} {describe_body(b)}   (after an error)")
        elif dry:
            res.update(status="dry_run", payload=b)
            print(f"dry-run  {r['key']:<12} {describe_body(b)}")
        else:
            try:
                created = call("POST", "/3.0/accounting/manual_entries", body=b)
            except SystemExit:
                res.update(status="error")
                print(f"ERROR    {r['key']:<12} {describe_body(b)}   stopping, see message above")
                stop = True
                results.append(res)
                continue
            res.update(status="created", entry_id=created.get("id"), reference_nr=created.get("reference_nr"))
            print(f"created  {r['key']:<12} {describe_body(b)}   id={created.get('id')} ref={created.get('reference_nr')}")
        results.append(res)
    if out_path:
        with open(out_path, "w") as f:
            json.dump(results, f, ensure_ascii=False, indent=1)
        print(f"results written to {out_path}")
    counts = {}
    for r in results:
        counts[r["status"]] = counts.get(r["status"], 0) + 1
    print("summary: " + ", ".join(f"{k}={v}" for k, v in sorted(counts.items())))
    if stop:
        sys.exit(2)


def cmd_get(args):
    if not args:
        die("get PATH [k=v ...]")
    params = dict(kv.split("=", 1) for kv in args[1:])
    print(json.dumps(call("GET", args[0], params or None), ensure_ascii=False, indent=1))


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(USAGE.rstrip())
        return
    cmds = {"check": cmd_check, "accounts": cmd_accounts, "journal": cmd_journal, "balance": cmd_balance,
            "entry": cmd_entry, "book": cmd_book, "get": cmd_get}
    fn = cmds.get(argv[0])
    if not fn:
        die(f"unknown command {argv[0]!r}\n{USAGE}")
    fn(argv[1:])


if __name__ == "__main__":
    main()
