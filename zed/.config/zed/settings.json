{
  "markdown_preview": {
    "font_family": "Andale Mono"
  },
  "buffer_line_height": "comfortable",
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "theme": "Ayu Dark",
  "vim_mode": false,
  "ui_font_size": 18,
  "buffer_font_size": 17.0,
  "buffer_font_family": "Fira Code",
  "ui_font_family": "Fira Code",
  "relative_line_numbers": "enabled",
  "tab_bar": {
    "show": false
  },
  "languages": {
    "TSX": {
      "code_actions_on_format": {
        // "source.organizeImports": true
      }
    },
    "TypeScript": {
      "code_actions_on_format": {
        // "source.organizeImports": true
      }
    }
  },
  "indent_guides": {
    "enabled": true
  },
  "journal": {
    "hour_format": "hour24"
  },
  "project_panel": {
    "dock": "right"
  }
}
